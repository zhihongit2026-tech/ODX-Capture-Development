<Window x:Class="Odx.App.SmartGuardOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ODX Smart Guard" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="Manual" IsHitTestVisible="False">
    <Border Background="#D91A1E27" BorderBrush="#665B6472" BorderThickness="1"
            CornerRadius="9" Padding="12,9" MaxWidth="460">
        <StackPanel>
            <!-- Separate columns prevent the title and countdown from touching. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="ODX SMART GUARD"
                           Foreground="#FFB8C7D9" FontSize="11" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,12,0" />
                <TextBlock Grid.Column="1" x:Name="CountdownText"
                           Foreground="#FFFFFFFF" FontSize="13" FontWeight="Bold"
                           Text="03:55" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>

            <!-- Status label and state are aligned independently from the title row. -->
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="TIME LEFT"
                           Foreground="#FF8F9BAA" FontSize="9" FontWeight="SemiBold"
                           VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" x:Name="StateText"
                           Foreground="#FF64D98B" FontSize="10" FontWeight="Bold"
                           Text="MONITORING" VerticalAlignment="Center"
                           HorizontalAlignment="Right" />
            </Grid>

            <ScrollViewer Margin="0,7,0,0" MaxHeight="300"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="AlertList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,3,0,2" Padding="0,2">
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}" Foreground="{Binding Brush}"
                                               FontWeight="SemiBold" FontSize="12"
                                               TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Detail}" Foreground="#FFE0E6ED"
                                               FontSize="10" TextWrapping="Wrap"
                                               Margin="0,2,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
