<Window x:Class="Odx.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ODX Capture - Smart Guard" Icon="odx.ico"
        Width="1180" Height="790" MinWidth="940" MinHeight="660"
        ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        Background="#06111E" Foreground="#E7F1FA">
    <Window.Resources>
        <Style TargetType="{x:Type Label}">
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="#9BB0C2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style TargetType="{x:Type Button}">
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Background" Value="#0D2B42" />
            <Setter Property="Foreground" Value="#E4F7FF" />
            <Setter Property="BorderBrush" Value="#18506D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#12415D" />
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#19BFEA" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#092236" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="NavButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="Background" Value="#071725" />
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="BorderBrush" Value="#1B4963" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CaretBrush" Value="#24C8F2" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Background" Value="#071725" />
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="BorderBrush" Value="#1B4963" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="34" />
            <Setter Property="Margin" Value="0,4" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Background" Value="#071725" />
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="BorderBrush" Value="#1B4963" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Background" Value="#0B1D2D" />
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="Padding" Value="8,6" />
        </Style>
        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#D6E8F5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70" />
            <RowDefinition Height="*" />
            <RowDefinition Height="34" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Application header -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#081827"
                BorderBrush="#15374E" BorderThickness="0,0,0,1" Padding="22,0">
            <DockPanel LastChildFill="True" VerticalAlignment="Center">
                <Border DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="10"
                        Background="#0B344C" BorderBrush="#1A7899" BorderThickness="1"
                        Margin="0,0,13,0">
                    <TextBlock Text="ODX" Foreground="#53D8F7" FontSize="13"
                               FontWeight="Bold" HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="ODX CAPTURE" Foreground="#F0F7FC"
                               FontSize="19" FontWeight="Bold" />
                    <TextBlock Text="SMART GUARD  ·  G1.3  ·  WINDOWS x64"
                               Foreground="#7F9BB0" FontSize="10" Margin="1,2,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Right" Background="#0B2B2A"
                        BorderBrush="#176B56" BorderThickness="1"
                        CornerRadius="14" Padding="12,6" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="#25E58F" Margin="0,0,8,0"
                                 VerticalAlignment="Center" />
                        <TextBlock Text="DESKTOP CONTROL CENTER" Foreground="#8BE9BD"
                                   FontSize="10" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- Section navigation. Each item scrolls to the corresponding live controls. -->
        <Border Grid.Row="1" Grid.Column="0" Background="#071522"
                BorderBrush="#15374E" BorderThickness="0,0,1,0" Padding="14,20">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="WORKSPACE" Foreground="#58768D" FontSize="10"
                               FontWeight="Bold" Margin="9,0,0,12" />
                    <Button Style="{StaticResource NavButtonStyle}" Click="NavigateDashboard_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="01" Foreground="#28C9F2" FontWeight="Bold" Width="28" />
                            <TextBlock Text="Tổng quan" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="NavigateCapture_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="02" Foreground="#28C9F2" FontWeight="Bold" Width="28" />
                            <TextBlock Text="Ghi hình" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="NavigateParty_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="03" Foreground="#28C9F2" FontWeight="Bold" Width="28" />
                            <TextBlock Text="Party / Room" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource NavButtonStyle}" Click="NavigateSettings_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="04" Foreground="#28C9F2" FontWeight="Bold" Width="28" />
                            <TextBlock Text="Cấu hình" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="8,0,0,4">
                    <Border Height="1" Background="#17374D" Margin="0,0,0,14" />
                    <TextBlock Text="ODX CAPTURE 0.3.5" Foreground="#63D8F5"
                               FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="Protocol 5" Foreground="#7892A7"
                               FontSize="11" Margin="0,4,0,0" />
                    <TextBlock Text="Arma 3 · Smart Guard" Foreground="#7892A7"
                               FontSize="10" Margin="0,3,0,0" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Dashboard content -->
        <ScrollViewer x:Name="DashboardScroll" Grid.Row="1" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="#06111E">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.55*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Main control card -->
                <Border x:Name="DashboardCard" Grid.Row="0" Grid.ColumnSpan="2"
                        Background="#0A1B2B" BorderBrush="#16506B" BorderThickness="1"
                        CornerRadius="12" Padding="18" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="DASHBOARD / ĐIỀU KHIỂN PHIÊN"
                                       Foreground="#E8F6FF" FontSize="14" FontWeight="Bold" />
                            <TextBlock DockPanel.Dock="Right" Text="LIVE CONTROL"
                                       Foreground="#35CFF5" FontSize="10" FontWeight="Bold" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="StartStopButton" AutomationProperties.AutomationId="StartStopButton"
                                    Grid.Column="0" Margin="0,0,14,0" Padding="16,15"
                                    FontSize="15" Click="StartStop_Click" />
                            <Border Grid.Column="1" Background="#071522" BorderBrush="#183C53"
                                    BorderThickness="1" CornerRadius="8" Padding="13,10">
                                <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText"
                                           TextWrapping="Wrap" VerticalAlignment="Center"
                                           Foreground="#C7D9E6" FontSize="12" MinHeight="24" />
                            </Border>
                        </Grid>
                        <TextBlock Text="AI Guard runs in its independent click-through overlay during supported recording sessions."
                                   Foreground="#7895A9" FontSize="10" Margin="1,11,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Capture settings: existing controls and event handlers are retained. -->
                <Border x:Name="CaptureCard" Grid.Row="1" Grid.Column="0"
                        Background="#0A1B2B" BorderBrush="#143B53" BorderThickness="1"
                        CornerRadius="12" Padding="17" Margin="0,0,10,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,13">
                            <TextBlock Text="GHI HÌNH / CAPTURE" Foreground="#E8F6FF"
                                       FontSize="13" FontWeight="Bold" />
                            <TextBlock DockPanel.Dock="Right" Text="SOURCE · FPS · AUDIO"
                                       Foreground="#4AABC7" FontSize="9" FontWeight="Bold" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Label x:Name="SourceLabel" Grid.Row="0" />
                            <ComboBox x:Name="SourceBox" AutomationProperties.AutomationId="SourceBox"
                                      Grid.Row="0" Grid.Column="1" DisplayMemberPath="Label" />
                            <Button x:Name="RefreshButton" Grid.Row="0" Grid.Column="2"
                                    Click="Refresh_Click" Padding="9,7" Content="Refresh" />

                            <Label x:Name="GameLabel" Grid.Row="1" />
                            <ComboBox x:Name="GameBox" AutomationProperties.AutomationId="GameBox"
                                      Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                      SelectionChanged="Game_Changed" DisplayMemberPath="Label" />

                            <Label x:Name="FpsLabel" Grid.Row="2" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                        Orientation="Horizontal" Margin="0,1,0,4">
                                <ComboBox x:Name="FpsBox" Width="86" />
                                <CheckBox x:Name="AudioBox" AutomationProperties.AutomationId="AudioBox"
                                          Margin="14,0,0,0" />
                            </StackPanel>

                            <Label x:Name="ObsLabel" Grid.Row="3" />
                            <CheckBox x:Name="ObsBox" AutomationProperties.AutomationId="ObsBox"
                                      Grid.Row="3" Grid.Column="1" Checked="Obs_Changed"
                                      Unchecked="Obs_Changed" />

                            <Label x:Name="ObsConnectionLabel" Grid.Row="4" />
                            <StackPanel x:Name="ObsConnectionPanel" Grid.Row="4" Grid.Column="1"
                                        Orientation="Horizontal" Margin="0,1,0,4">
                                <TextBlock x:Name="ObsAddressLabel" VerticalAlignment="Center"
                                           Foreground="#9BB0C2" Margin="0,0,5,0" FontSize="11" />
                                <TextBox x:Name="ObsAddressBox" AutomationProperties.AutomationId="ObsAddressBox"
                                         Width="105" />
                                <TextBlock x:Name="ObsPasswordLabel" VerticalAlignment="Center"
                                           Foreground="#9BB0C2" Margin="9,0,5,0" FontSize="11" />
                                <PasswordBox x:Name="ObsPasswordBox" AutomationProperties.AutomationId="ObsPasswordBox"
                                             Width="88" />
                            </StackPanel>
                            <Button x:Name="ObsTestButton" AutomationProperties.AutomationId="ObsTestButton"
                                    Grid.Row="4" Grid.Column="2" Click="ObsTest_Click"
                                    Padding="9,7" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Language and hotkey settings -->
                <Border x:Name="SettingsCard" Grid.Row="1" Grid.Column="1"
                        Background="#0A1B2B" BorderBrush="#143B53" BorderThickness="1"
                        CornerRadius="12" Padding="17" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="CẤU HÌNH / PREFERENCES" Foreground="#E8F6FF"
                                   FontSize="13" FontWeight="Bold" Margin="0,0,0,13" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="82" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label x:Name="LanguageLabel" Grid.Row="0" />
                            <ComboBox x:Name="LanguageBox" AutomationProperties.AutomationId="LanguageBox"
                                      Grid.Row="0" Grid.Column="1" DisplayMemberPath="Name"
                                      SelectionChanged="Language_Changed" />
                            <Label x:Name="HotkeyLabel" Grid.Row="1" />
                            <TextBox x:Name="HotkeyBox" AutomationProperties.AutomationId="HotkeyBox"
                                     Grid.Row="1" Grid.Column="1" IsReadOnly="True"
                                     IsReadOnlyCaretVisible="False" GotKeyboardFocus="Hotkey_GotFocus"
                                     LostKeyboardFocus="Hotkey_LostFocus"
                                     PreviewKeyDown="Hotkey_PreviewKeyDown" />
                        </Grid>
                        <TextBlock Text="Hotkey có thể đổi bằng cách chọn ô và nhấn tổ hợp phím mới."
                                   Foreground="#7895A9" FontSize="10" Margin="0,8,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- Party and room controls -->
                <Border x:Name="PartyCard" Grid.Row="2" Grid.ColumnSpan="2"
                        Background="#0A1B2B" BorderBrush="#143B53" BorderThickness="1"
                        CornerRadius="12" Padding="17" Margin="0,0,0,14">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,13">
                            <TextBlock Text="PARTY / ROOM" Foreground="#E8F6FF"
                                       FontSize="13" FontWeight="Bold" />
                            <TextBlock DockPanel.Dock="Right" Text="PROTOCOL 5"
                                       Foreground="#4AABC7" FontSize="9" FontWeight="Bold" />
                        </DockPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="88" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Label x:Name="PlayerLabel" Grid.Row="0" />
                            <StackPanel x:Name="PlayerPanel" Grid.Row="0" Grid.Column="1"
                                        Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBox x:Name="PlayerBox" AutomationProperties.AutomationId="PlayerBox"
                                         Width="145" />
                                <Label x:Name="NameLabel" Margin="12,0,8,0" />
                                <TextBox x:Name="NameBox" AutomationProperties.AutomationId="NameBox"
                                         Width="165" />
                            </StackPanel>
                            <Label x:Name="RoomLabel" Grid.Row="1" />
                            <StackPanel x:Name="RoomPanel" Grid.Row="1" Grid.Column="1"
                                        Orientation="Horizontal" Margin="0,0,0,0">
                                <TextBox x:Name="RoomBox" AutomationProperties.AutomationId="RoomBox"
                                         Width="104" IsReadOnly="True" Visibility="Collapsed"
                                         FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                                         HorizontalContentAlignment="Center" />
                                <TextBlock x:Name="TaskLabel" Visibility="Collapsed"
                                           VerticalAlignment="Center" Margin="10,0,5,0"
                                           Foreground="#9BB0C2" FontSize="11" />
                                <TextBox x:Name="TaskBox" AutomationProperties.AutomationId="TaskBox"
                                         Width="130" Visibility="Collapsed" Margin="0,4,8,4" />
                                <Button x:Name="JoinButton" AutomationProperties.AutomationId="JoinButton"
                                        Click="Join_Click" />
                                <Button x:Name="CreateButton" AutomationProperties.AutomationId="CreateButton"
                                        Click="Create_Click" />
                                <Button x:Name="SyncClockButton" AutomationProperties.AutomationId="SyncClockButton"
                                        Visibility="Collapsed" Click="SyncClock_Click" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#081827"
                BorderBrush="#15374E" BorderThickness="0,1,0,0" Padding="20,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="ODX CAPTURE 0.3.5  ·  SMART GUARD G1.3"
                           Foreground="#6F8BA1" FontSize="10" />
                <TextBlock DockPanel.Dock="Right" Text="Windows x64"
                           Foreground="#6F8BA1" FontSize="10" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
