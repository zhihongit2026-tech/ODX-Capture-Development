<Window x:Class="Odx.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="ODX Capture - Smart Guard" Icon="odx.ico"
        Width="1500" Height="900" MinWidth="1180" MinHeight="720"
        WindowState="Maximized" WindowStyle="None" ResizeMode="CanResize"
        Background="#03101C" Foreground="#EAF6FF"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        SnapsToDevicePixels="True">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="38" ResizeBorderThickness="6"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#071B2B" />
        <SolidColorBrush x:Key="PanelBrush2" Color="#092238" />
        <SolidColorBrush x:Key="LineBrush" Color="#1B607D" />
        <SolidColorBrush x:Key="CyanBrush" Color="#16D9F4" />
        <SolidColorBrush x:Key="MutedBrush" Color="#8DAFC3" />

        <Style TargetType="{x:Type Label}">
            <Setter Property="Foreground" Value="#D6E8F5" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Foreground" Value="#F1FAFF" />
            <Setter Property="Background" Value="#061827" />
            <Setter Property="BorderBrush" Value="#28617D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="CaretBrush" Value="#29E6F7" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                        <Border x:Name="TextBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="TextBorder" Property="BorderBrush" Value="#24D7F2" />
                                <Setter TargetName="TextBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#14BFEA" BlurRadius="10" ShadowDepth="0" Opacity="0.28" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="TextBorder" Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type PasswordBox}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Foreground" Value="#F1FAFF" />
            <Setter Property="Background" Value="#061827" />
            <Setter Property="BorderBrush" Value="#28617D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type PasswordBox}">
                        <Border x:Name="PasswordBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="PasswordBorder" Property="BorderBrush" Value="#24D7F2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PasswordBorder" Property="Opacity" Value="0.52" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#EAF7FF" />
            <Setter Property="Background" Value="#0A2133" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#12405A" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#15516C" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type ComboBox}">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="0,3" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Foreground" Value="#F0FAFF" />
            <Setter Property="Background" Value="#0B2A40" />
            <Setter Property="BorderBrush" Value="#39718B" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <Border x:Name="ComboBorder" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <ContentPresenter Grid.Column="0" Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center" HorizontalAlignment="Left"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      IsHitTestVisible="False" />
                                    <ToggleButton Grid.Column="1" Focusable="False" ClickMode="Press"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                                <Border Background="Transparent">
                                                    <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets"
                                                               Foreground="#A7D8E8" FontSize="13"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>
                            </Border>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">
                                <Border Background="#081D2D" BorderBrush="#2C7897"
                                        BorderThickness="1" CornerRadius="8"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer CanContentScroll="True" SnapsToDevicePixels="True">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboBorder" Property="BorderBrush" Value="#22D6F2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboBorder" Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type CheckBox}">
            <Setter Property="Foreground" Value="#E3F2FA" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type CheckBox}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="CheckBorder" Width="22" Height="22" CornerRadius="5"
                                    BorderBrush="#3C829C" BorderThickness="1.2" Background="#061A2A">
                                <TextBlock x:Name="CheckGlyph" Text="&#xE73E;"
                                           FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Foreground="#03131F" HorizontalAlignment="Center"
                                           VerticalAlignment="Center" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckBorder" Property="Background" Value="#25D7E9" />
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#5CF3FF" />
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CheckBorder" Property="BorderBrush" Value="#2CE2F5" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.48" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type Button}">
            <Setter Property="Foreground" Value="#EAF8FF" />
            <Setter Property="Background" Value="#0B2D45" />
            <Setter Property="BorderBrush" Value="#286D8A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="17,10" />
            <Setter Property="Margin" Value="4,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              Margin="2" RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#2BE3FA" />
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#10415B" />
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#11C7F0" BlurRadius="12" ShadowDepth="0" Opacity="0.25" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#062238" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="IconButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                        VerticalAlignment="Center" Margin="13,1">
                                <TextBlock Text="{TemplateBinding Tag}" FontFamily="Segoe MDL2 Assets"
                                           FontSize="15" Foreground="#35E4F5"
                                           VerticalAlignment="Center" Margin="0,0,9,0" />
                                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="BorderBrush" Value="#2BE3FA" />
                                <Setter TargetName="IconButtonBorder" Property="Background" Value="#10415B" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconButtonBorder" Property="Background" Value="#062238" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="IconButtonBorder" Property="Opacity" Value="0.42" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryActionButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#12AFC4" Offset="0" />
                        <GradientStop Color="#087D99" Offset="0.5" />
                        <GradientStop Color="#07516F" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#38F2FF" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Padding" Value="24,18" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="PrimaryBorder" CornerRadius="23"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Background="{TemplateBinding Background}">
                            <Border.Effect>
                                <DropShadowEffect Color="#00D9F5" BlurRadius="20" ShadowDepth="0" Opacity="0.42" />
                            </Border.Effect>
                            <Grid>
                                <Path Data="M 0,0 L 170,0 L 90,90 L 0,90 Z" Fill="#27E7F4" Opacity="0.07"
                                      HorizontalAlignment="Left" Stretch="Fill" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="34" Foreground="#72F9FF"
                                               VerticalAlignment="Center" Margin="0,0,18,0" />
                                    <ContentPresenter VerticalAlignment="Center"
                                                      RecognizesAccessKey="True" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="BorderBrush" Value="#A5FCFF" />
                                <Setter TargetName="PrimaryBorder" Property="Background">
                                    <Setter.Value>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                            <GradientStop Color="#16C9DA" Offset="0" />
                                            <GradientStop Color="#0B92B1" Offset="0.52" />
                                            <GradientStop Color="#076483" Offset="1" />
                                        </LinearGradientBrush>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.82" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="PrimaryBorder" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavigationButton" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="13,12" />
            <Setter Property="Margin" Value="0,5" />
            <Setter Property="Background" Value="#061A29" />
            <Setter Property="BorderBrush" Value="#061A29" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="CardBorder" TargetType="{x:Type Border}">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0A263B" Offset="0" />
                        <GradientStop Color="#061A2B" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#1B7897" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="17" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#00101A" BlurRadius="15" ShadowDepth="4" Opacity="0.48" />
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#03111E">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="82" />
            <RowDefinition Height="*" />
            <RowDefinition Height="62" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="274" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Dark native-style title strip -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#04111D"
                BorderBrush="#16364C" BorderThickness="0,0,0,1">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="17,0,0,0">
                    <Border Width="19" Height="19" CornerRadius="5" Background="#0A3147"
                            BorderBrush="#1B94B5" BorderThickness="1" Margin="0,0,9,0">
                        <TextBlock Text="O" FontSize="11" FontWeight="Bold" Foreground="#47E6F8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ODX Capture - Smart Guard" FontSize="13"
                               Foreground="#C9DCE8" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="MinimizeButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="46" Height="37" Padding="0" Margin="0" Background="Transparent"
                            BorderBrush="Transparent" Click="WindowMinimize_Click">
                        <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#B6CBD8" />
                    </Button>
                    <Button x:Name="MaximizeButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="46" Height="37" Padding="0" Margin="0" Background="Transparent"
                            BorderBrush="Transparent" Click="WindowMaximize_Click">
                        <TextBlock Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#B6CBD8" />
                    </Button>
                    <Button x:Name="CloseButton" shell:WindowChrome.IsHitTestVisibleInChrome="True"
                            Width="50" Height="37" Padding="0" Margin="0" Background="Transparent"
                            BorderBrush="Transparent" Click="WindowClose_Click">
                        <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#D9E7EE" />
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Branded header -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#061A2A"
                BorderBrush="#17455D" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="274" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="35,0,0,0">
                    <Border Width="58" Height="58" CornerRadius="15" BorderThickness="2"
                            BorderBrush="#18D9EF" Background="#062C40">
                        <Border.Effect>
                            <DropShadowEffect Color="#00CFF0" BlurRadius="16" ShadowDepth="0" Opacity="0.3" />
                        </Border.Effect>
                        <TextBlock Text="ODX" FontSize="21" FontWeight="Bold" Foreground="#39E9F8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Margin="17,0,0,0">
                        <TextBlock Text="ODX CAPTURE" FontSize="24" FontWeight="Bold"
                                   Foreground="#F4FAFE" />
                        <TextBlock Text="SMART GUARD   ·   G1.3   ·   WINDOWS x64"
                                   FontSize="12" Foreground="#9FC2D4" Margin="1,3,0,0" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" Margin="18,0,38,0" Height="42" CornerRadius="22"
                        BorderBrush="#08A875" BorderThickness="1"
                        Background="#062E2B" VerticalAlignment="Center">
                    <Border.Effect>
                        <DropShadowEffect Color="#00D58C" BlurRadius="13" ShadowDepth="0" Opacity="0.18" />
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="21,0,0,0">
                        <Ellipse Width="12" Height="12" Fill="#20E99A" Margin="0,0,14,0" />
                        <TextBlock Text="DESKTOP CONTROL CENTER" FontSize="15" FontWeight="Bold"
                                   Foreground="#35E9A7" />
                    </StackPanel>
                </Border>
                <Canvas Grid.Column="1" HorizontalAlignment="Right" Width="350" IsHitTestVisible="False">
                    <Path Data="M 205,0 L 270,0 L 155,82 L 90,82 Z" Fill="#0A5C79" Opacity="0.22" />
                    <Path Data="M 270,0 L 330,0 L 215,82 L 155,82 Z" Fill="#0B7891" Opacity="0.18" />
                    <Path Data="M 330,0 L 350,0 L 235,82 L 215,82 Z" Fill="#0D9BB0" Opacity="0.16" />
                </Canvas>
            </Grid>
        </Border>

        <!-- Left workspace navigation -->
        <Border Grid.Row="2" Grid.Column="0" Background="#041827"
                BorderBrush="#1B4A63" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Margin="27,31,18,0">
                    <TextBlock Text="WORKSPACE" Foreground="#86AFC3" FontSize="13"
                               FontWeight="Bold" Margin="10,0,0,23" />
                    <Button x:Name="NavDashboard" Style="{StaticResource NavigationButton}"
                            Background="#06435A" BorderBrush="#20D9EF" Click="NavigateDashboard_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="24" Foreground="#20E8F6" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="01" FontSize="15" Foreground="#43E5F4"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Tổng quan" FontSize="17"
                                       Foreground="#F3FBFF" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavCapture" Style="{StaticResource NavigationButton}" Click="NavigateCapture_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                                       Foreground="#C8E0ED" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="02" FontSize="15" Foreground="#42D8EF"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Ghi hình" FontSize="17"
                                       Foreground="#E4F1F8" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavParty" Style="{StaticResource NavigationButton}" Click="NavigateParty_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                                       Foreground="#C8E0ED" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="03" FontSize="15" Foreground="#42D8EF"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Party / Room" FontSize="17"
                                       Foreground="#E4F1F8" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Button x:Name="NavSettings" Style="{StaticResource NavigationButton}" Click="NavigateSettings_Click">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="23"
                                       Foreground="#C8E0ED" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="04" FontSize="15" Foreground="#42D8EF"
                                       VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" Text="Cấu hình" FontSize="17"
                                       Foreground="#E4F1F8" VerticalAlignment="Center" />
                        </Grid>
                    </Button>
                    <Border Height="1" Background="#24536A" Margin="0,27,8,22" />
                    <TextBlock Text="ODX CAPTURE 0.3.5" Foreground="#2CE2F1"
                               FontSize="15" FontWeight="Bold" Margin="10,0,0,9" />
                    <TextBlock Text="Protocol 5" Foreground="#A3C0D0" FontSize="14" Margin="10,0,0,5" />
                    <TextBlock Text="Arma 3 · Smart Guard" Foreground="#A3C0D0" FontSize="14" Margin="10,0,0,0" />
                </StackPanel>

                <Grid Grid.Row="1" Height="215" ClipToBounds="True">
                    <Image Source="pack://application:,,,/dashboard-sidebar-art.jpg"
                           Stretch="UniformToFill" Opacity="0.78" />
                    <Rectangle>
                        <Rectangle.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#041827" Offset="0" />
                                <GradientStop Color="#17041827" Offset="0.28" />
                                <GradientStop Color="#00101C" Offset="1" />
                            </LinearGradientBrush>
                        </Rectangle.Fill>
                    </Rectangle>
                    <Rectangle Fill="#06334C" Opacity="0.18" />
                </Grid>
            </Grid>
        </Border>

        <!-- Main dashboard -->
        <ScrollViewer x:Name="DashboardScroll" Grid.Row="2" Grid.Column="1"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                      Background="#03111E">
            <Grid Margin="18,17,20,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Session command center -->
                <Border x:Name="DashboardCard" Style="{StaticResource CardBorder}"
                        Grid.Row="0" Padding="34,20,18,18" Margin="0,0,0,16"
                        MinHeight="270">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="42" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="36" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="8,0,0,10">
                            <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets"
                                       FontSize="27" Foreground="#25E5F4" Margin="0,0,18,0" />
                            <TextBlock Text="DASHBOARD / ĐIỀU KHIỂN PHIÊN"
                                       Foreground="#F1F9FE" FontSize="23" FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="LIVE CONTROL" Foreground="#20E5F4"
                                       FontSize="13" FontWeight="Bold" Margin="24,5,0,0"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <Border Grid.Row="1" Background="#061A2A" BorderBrush="#1D5973"
                                BorderThickness="1" CornerRadius="17" Padding="10" ClipToBounds="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="0.92*" />
                                    <ColumnDefinition Width="1.95*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="StartStopButton" AutomationProperties.AutomationId="StartStopButton"
                                        Grid.Column="0" Style="{StaticResource PrimaryActionButton}"
                                        Margin="0,10,18,10" Click="StartStop_Click" />
                                <Border Grid.Column="1" Background="#061827" BorderBrush="#143E56"
                                        BorderThickness="0,0,0,0" Padding="28,10,15,10">
                                    <Grid>
                                        <Image Source="pack://application:,,,/dashboard-sidebar-art.jpg"
                                               HorizontalAlignment="Right" VerticalAlignment="Stretch"
                                               Width="270" Stretch="UniformToFill" Opacity="0.16" />
                                        <Rectangle>
                                            <Rectangle.Fill>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Color="#061827" Offset="0" />
                                                    <GradientStop Color="#061827" Offset="0.68" />
                                                    <GradientStop Color="#001B3D52" Offset="1" />
                                                </LinearGradientBrush>
                                            </Rectangle.Fill>
                                        </Rectangle>
                                        <Border HorizontalAlignment="Left" Width="1" Background="#28728B"
                                                Margin="-17,0,0,0" />
                                        <TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText"
                                                   TextWrapping="Wrap" Foreground="#E6F3FB"
                                                   FontSize="14.5" LineHeight="19"
                                                   VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom"
                                    Margin="11,9,0,0">
                            <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="#91C9DB" FontSize="16" Margin="0,0,12,0" />
                            <TextBlock Text="AI Guard runs in its independent click-through overlay during supported recording sessions."
                                       Foreground="#8DB3C7" FontSize="12" VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Capture and preferences cards -->
                <Grid Grid.Row="1" Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.48*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <Border x:Name="CaptureCard" Grid.Column="0" Style="{StaticResource CardBorder}"
                            Padding="30,20,25,20" Margin="0,0,8,0" MinHeight="214">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,15">
                                <TextBlock Text="&#xE714;" FontFamily="Segoe MDL2 Assets"
                                           Foreground="#22E7F6" FontSize="25" Margin="0,0,17,0" />
                                <TextBlock Text="GHI HÌNH / CAPTURE" Foreground="#F2FAFE"
                                           FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Text="SOURCE  ·  FPS  ·  AUDIO" Foreground="#27DDF0"
                                           FontSize="12" FontWeight="Bold" Margin="20,4,0,0"
                                           VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="48" />
                                    <RowDefinition Height="43" />
                                    <RowDefinition Height="48" />
                                </Grid.RowDefinitions>

                                <Label x:Name="SourceLabel" Grid.Row="0" Content="Nguồn quay" />
                                <ComboBox x:Name="SourceBox" AutomationProperties.AutomationId="SourceBox"
                                          Grid.Row="0" Grid.Column="1" DisplayMemberPath="Label" />
                                <Button x:Name="RefreshButton" Grid.Row="0" Grid.Column="2" Style="{StaticResource IconButton}" Tag="&#xE72C;"
                                        Click="Refresh_Click" Padding="15,7" Margin="10,3,0,3">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="#2DE7F4" Margin="0,0,9,0" />
                                        <TextBlock Text="Làm mới" />
                                    </StackPanel>
                                </Button>

                                <Label x:Name="GameLabel" Grid.Row="1" Content="Hồ sơ game" />
                                <ComboBox x:Name="GameBox" AutomationProperties.AutomationId="GameBox"
                                          Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                          SelectionChanged="Game_Changed" DisplayMemberPath="Label" />

                                <Label x:Name="FpsLabel" Grid.Row="2" Content="FPS" />
                                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                            Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="FpsBox" Width="150" HorizontalAlignment="Left" />
                                    <CheckBox x:Name="AudioBox" AutomationProperties.AutomationId="AudioBox"
                                              Margin="30,0,0,0" />
                                </StackPanel>

                                <Label x:Name="ObsLabel" Grid.Row="3" Content="Video / OBS" />
                                <CheckBox x:Name="ObsBox" AutomationProperties.AutomationId="ObsBox"
                                          Grid.Row="3" Grid.Column="1" Checked="Obs_Changed"
                                          Unchecked="Obs_Changed" />

                                <Label x:Name="ObsConnectionLabel" Grid.Row="4" Content="OBS Server" />
                                <StackPanel x:Name="ObsConnectionPanel" Grid.Row="4" Grid.Column="1"
                                            Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="ObsAddressLabel" VerticalAlignment="Center"
                                               Foreground="#A8C4D3" Margin="0,0,8,0" FontSize="12" />
                                    <TextBox x:Name="ObsAddressBox" AutomationProperties.AutomationId="ObsAddressBox"
                                             Width="150" />
                                    <TextBlock x:Name="ObsPasswordLabel" VerticalAlignment="Center"
                                               Foreground="#A8C4D3" Margin="14,0,8,0" FontSize="12" />
                                    <PasswordBox x:Name="ObsPasswordBox" AutomationProperties.AutomationId="ObsPasswordBox"
                                                 Width="125" />
                                </StackPanel>
                                <Button x:Name="ObsTestButton" AutomationProperties.AutomationId="ObsTestButton"
                                        Grid.Row="4" Grid.Column="2" Style="{StaticResource IconButton}" Tag="&#xE9CE;"
                                        Click="ObsTest_Click" Padding="13,8" Margin="10,3,0,3" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border x:Name="SettingsCard" Grid.Column="1" Style="{StaticResource CardBorder}"
                            Padding="30,20,28,20" Margin="8,0,0,0" MinHeight="214">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,15">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                           Foreground="#22E7F6" FontSize="25" Margin="0,0,17,0" />
                                <TextBlock Text="CẤU HÌNH / PREFERENCES" Foreground="#F2FAFE"
                                           FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                            </DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="145" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="52" />
                                    <RowDefinition Height="52" />
                                </Grid.RowDefinitions>
                                <Label x:Name="LanguageLabel" Grid.Row="0" Content="Ngôn ngữ" />
                                <ComboBox x:Name="LanguageBox" AutomationProperties.AutomationId="LanguageBox"
                                          Grid.Row="0" Grid.Column="1" DisplayMemberPath="Name"
                                          SelectionChanged="Language_Changed" />
                                <Label x:Name="HotkeyLabel" Grid.Row="1" Content="Phím tắt bật" />
                                <TextBox x:Name="HotkeyBox" AutomationProperties.AutomationId="HotkeyBox"
                                         Grid.Row="1" Grid.Column="1" IsReadOnly="True"
                                         IsReadOnlyCaretVisible="False" GotKeyboardFocus="Hotkey_GotFocus"
                                         LostKeyboardFocus="Hotkey_LostFocus"
                                         PreviewKeyDown="Hotkey_PreviewKeyDown" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets"
                                           Foreground="#72C7DA" FontSize="15" Margin="0,0,9,0" />
                                <TextBlock Text="Hotkey có thể đổi bằng cách chọn ô và nhấn tổ hợp phím mới."
                                           Foreground="#8DB2C6" FontSize="12" TextWrapping="Wrap" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Party / room control -->
                <Border x:Name="PartyCard" Grid.Row="2" Style="{StaticResource CardBorder}"
                        Padding="30,19,28,20" MinHeight="188">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="45" />
                            <RowDefinition Height="58" />
                            <RowDefinition Height="58" />
                        </Grid.RowDefinitions>
                        <DockPanel Grid.Row="0" Margin="8,0,0,8">
                            <TextBlock Text="&#xE716;" FontFamily="Segoe MDL2 Assets"
                                       Foreground="#22E7F6" FontSize="26" Margin="0,0,18,0" />
                            <TextBlock Text="PARTY / ROOM" Foreground="#F2FAFE"
                                       FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                            <TextBlock Text="PROTOCOL 5" Foreground="#27DDF0"
                                       FontSize="12" FontWeight="Bold" Margin="20,4,0,0"
                                       VerticalAlignment="Center" />
                        </DockPanel>
                        <Grid x:Name="PlayerPanel" Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="245" />
                                <ColumnDefinition Width="75" />
                                <ColumnDefinition Width="245" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label x:Name="PlayerLabel" Grid.Column="0" Content="Mã người chơi" />
                            <TextBox x:Name="PlayerBox" AutomationProperties.AutomationId="PlayerBox"
                                     Grid.Column="1" HorizontalAlignment="Stretch" />
                            <Label x:Name="NameLabel" Grid.Column="2" Content="Tên" Margin="18,0,12,0" />
                            <TextBox x:Name="NameBox" AutomationProperties.AutomationId="NameBox"
                                     Grid.Column="3" HorizontalAlignment="Stretch" />
                        </Grid>
                        <Grid x:Name="RoomPanel" Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="190" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Label x:Name="RoomLabel" Grid.Column="0" Content="Room" />
                            <TextBox x:Name="RoomBox" AutomationProperties.AutomationId="RoomBox"
                                     Grid.Column="1" Width="170" IsReadOnly="True" Visibility="Collapsed"
                                     FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                     HorizontalContentAlignment="Center" Foreground="#66F4FF"
                                     BorderBrush="#19D8ED" />
                            <TextBlock x:Name="TaskLabel" Grid.Column="2" Text="Task ID"
                                       Visibility="Collapsed" VerticalAlignment="Center"
                                       Foreground="#B6D0DE" FontSize="12" Margin="20,0,8,0" />
                            <TextBox x:Name="TaskBox" AutomationProperties.AutomationId="TaskBox"
                                     Grid.Column="3" Width="220" Visibility="Collapsed"
                                     VerticalContentAlignment="Center" />
                            <Button x:Name="JoinButton" AutomationProperties.AutomationId="JoinButton"
                                    Grid.Column="4" Style="{StaticResource IconButton}" Tag="&#xE8B7;"
                                    Click="Join_Click" Margin="12,3,4,3" Padding="20,9" />
                            <Button x:Name="CreateButton" AutomationProperties.AutomationId="CreateButton"
                                    Grid.Column="5" Style="{StaticResource IconButton}" Tag="&#xE710;"
                                    Click="Create_Click" Margin="8,3,4,3" Padding="20,9" />
                            <Button x:Name="SyncClockButton" AutomationProperties.AutomationId="SyncClockButton"
                                    Grid.Column="6" Style="{StaticResource IconButton}" Tag="&#xE823;"
                                    Visibility="Collapsed" Click="SyncClock_Click" Margin="8,3,4,3" Padding="18,9" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Bottom status strip -->
        <Border Grid.Row="3" Grid.ColumnSpan="2" Background="#041725"
                BorderBrush="#1C536B" BorderThickness="0,1,0,0" Padding="39,0,40,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="ODX CAPTURE 0.3.5    ·    SMART GUARD G1.3    ·    WINDOWS x64"
                           Foreground="#9BBACB" FontSize="13" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,28,0">
                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets"
                               Foreground="#91C8D9" FontSize="17" Margin="0,0,10,0" />
                    <TextBlock Text="Protocol 5" Foreground="#D1E5F0" FontSize="14" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets"
                               Foreground="#91C8D9" FontSize="17" Margin="0,0,10,0" />
                    <TextBlock Text="Arma 3 · Smart Guard" Foreground="#D1E5F0" FontSize="14" />
                </StackPanel>
                <Canvas Grid.ColumnSpan="3" HorizontalAlignment="Center" Width="150"
                        IsHitTestVisible="False">
                    <Path Data="M 35,0 L 65,0 L 25,62 L -5,62 Z" Fill="#0B91AE" Opacity="0.42" />
                    <Path Data="M 72,0 L 102,0 L 62,62 L 32,62 Z" Fill="#16C5D5" Opacity="0.32" />
                </Canvas>
            </Grid>
        </Border>
    </Grid>
</Window>
