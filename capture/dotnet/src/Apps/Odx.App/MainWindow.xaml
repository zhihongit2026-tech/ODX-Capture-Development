<Window x:Class="Odx.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ODX Capture 0.3.4 | Tbrain Work" Icon="odx.ico" Width="1600" Height="900"
        MinWidth="1100" MinHeight="650" ResizeMode="CanResize" Background="#070D18"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <!-- Scoped design tokens for the three previously light Windows controls. -->
    <Style x:Key="TbrainToolbarButtonStyle" TargetType="{x:Type Button}">
      <Setter Property="Background" Value="#192D4B"/>
      <Setter Property="Foreground" Value="#EAF2FF"/>
      <Setter Property="BorderBrush" Value="#365680"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="MinHeight" Value="30"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type Button}">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#244672"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="#5B87CB"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="#18365E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The default Windows ComboBox draws a white selection area and popup. -->
    <Style x:Key="TbrainTaskFilterOptionStyle" TargetType="{x:Type ComboBoxItem}">
      <Setter Property="Foreground" Value="#EBF3FF"/>
      <Setter Property="Background" Value="#10223D"/>
      <Setter Property="Padding" Value="11,7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBoxItem}">
            <Border x:Name="ItemChrome" CornerRadius="4" Background="{TemplateBinding Background}"
                    Padding="{TemplateBinding Padding}" Margin="2,1">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="#284D7E"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="ItemChrome" Property="Background" Value="#1D416E"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TbrainTaskFilterComboStyle" TargetType="{x:Type ComboBox}">
      <Setter Property="Background" Value="#172A47"/>
      <Setter Property="Foreground" Value="#ECF4FF"/>
      <Setter Property="BorderBrush" Value="#40618E"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Height" Value="30"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ComboBox}">
            <Grid SnapsToDevicePixels="True">
              <ToggleButton x:Name="DropDownToggle" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Foreground="{TemplateBinding Foreground}" Focusable="False" ClickMode="Press"
                            IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                <ToggleButton.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border x:Name="DropChrome" CornerRadius="6" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                      <Grid>
                        <TextBlock Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"
                                   Foreground="#EEF5FF" Margin="10,0,26,0" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" FontSize="12"/>
                        <Path Data="M 0 0 L 4 4 L 8 0" Stroke="#A9C5F0" StrokeThickness="1.8"
                              StrokeLineJoin="Round" HorizontalAlignment="Right" VerticalAlignment="Center"
                              Margin="0,0,10,0"/>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="DropChrome" Property="Background" Value="#244672"/>
                        <Setter TargetName="DropChrome" Property="BorderBrush" Value="#5B87CB"/>
                      </Trigger>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="DropChrome" Property="Background" Value="#1D416C"/>
                        <Setter TargetName="DropChrome" Property="BorderBrush" Value="#6896D9"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </ToggleButton.Template>
              </ToggleButton>
              <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                     IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="Fade">
                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                        MaxHeight="220" CornerRadius="6" BorderThickness="1" BorderBrush="#426893"
                        Background="#10223D" Margin="0,3,0,0" Padding="3">
                  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                CanContentScroll="True">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- Only applied to the task list, never to the recording/Room controls. -->
    <Style x:Key="TbrainTaskScrollBarStyle" TargetType="{x:Type ScrollBar}">
      <Setter Property="Width" Value="12"/>
      <Setter Property="Background" Value="#0C1C32"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ScrollBar}">
            <Grid Background="{TemplateBinding Background}" Width="12">
              <Track x:Name="PART_Track" IsDirectionReversed="True"
                     Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}"
                     Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Opacity="0"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Margin="3,2,3,2">
                    <Thumb.Template>
                      <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="Grabber" Background="#426895" CornerRadius="4"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grabber" Property="Background" Value="#6C9EE0"/>
                          </Trigger>
                          <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grabber" Property="Background" Value="#8BB5F3"/>
                          </Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Opacity="0"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="TbrainTaskRowStyle" TargetType="{x:Type ListBoxItem}">
      <Setter Property="Foreground" Value="#EAF3FF"/>
      <Setter Property="Padding" Value="3,1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="{x:Type ListBoxItem}">
            <Border x:Name="RowChrome" Background="Transparent" CornerRadius="5"
                    Margin="2,1" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="RowChrome" Property="Background" Value="#173052"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="RowChrome" Property="Background" Value="#204576"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.5"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="35*" MinWidth="520"/>
      <ColumnDefinition Width="6"/>
      <ColumnDefinition Width="65*" MinWidth="550"/>
    </Grid.ColumnDefinitions>
    <Grid Grid.Column="0" Background="#0A1323">
      <Grid.Resources>
        <Style TargetType="Label">
          <Setter Property="Foreground" Value="#C8D8F4"/>
          <Setter Property="Margin" Value="0,0,7,7"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
          <Setter Property="Background" Value="#21395F"/>
          <Setter Property="Foreground" Value="#F4F8FF"/>
          <Setter Property="BorderBrush" Value="#3C5276"/>
          <Setter Property="Margin" Value="5,0,0,6"/>
          <Setter Property="Padding" Value="10,6"/>
        </Style>
        <Style TargetType="TextBox">
          <Setter Property="Foreground" Value="#EEF5FF"/>
          <Setter Property="Background" Value="#172840"/>
          <Setter Property="BorderBrush" Value="#42618A"/>
          <Setter Property="Padding" Value="5,3"/>
        </Style>
        <Style TargetType="PasswordBox">
          <Setter Property="Foreground" Value="#EEF5FF"/>
          <Setter Property="Background" Value="#172840"/>
          <Setter Property="BorderBrush" Value="#42618A"/>
        </Style>
        <Style TargetType="CheckBox">
          <Setter Property="Foreground" Value="#E9F1FF"/>
          <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
          <Setter Property="Background" Value="#22395A"/>
          <Setter Property="Foreground" Value="#EDF5FF"/>
          <Setter Property="BorderBrush" Value="#476C9A"/>
        </Style>
      </Grid.Resources>
      <Grid.RowDefinitions>
        <RowDefinition Height="60"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Background="#10213B" LastChildFill="True">
        <Border DockPanel.Dock="Left" Margin="14,12,8,12" CornerRadius="7" Background="#2863F0" Width="33">
          <TextBlock Text="●" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="17"/>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="ODX Capture" FontSize="17" Foreground="#F3F7FF" FontWeight="Bold"/>
          <TextBlock Text="Tbrain Workspace · Tasks &amp; Recordings" FontSize="11" Foreground="#91ACD5"/>
        </StackPanel>
      </DockPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="12,12,12,16" Loaded="TaskBoard_Loaded">
          <!-- Task board: independent of the original host Room TaskBox. -->
          <Border Background="#14243D" CornerRadius="10" BorderBrush="#2B4F81" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <StackPanel>
              <DockPanel>
                <TextBlock Text="TASK ID · TBRAIN" FontSize="13" FontWeight="Bold" Foreground="#F1F7FF" DockPanel.Dock="Left"/>
                <Button x:Name="TaskSyncButton" DockPanel.Dock="Right" Content="Đồng bộ" Click="TaskSync_Click" Margin="5,0,0,2" Padding="9,3"/>
              </DockPanel>
              <TextBlock x:Name="TaskSyncStatus" Text="Mở một dự án Tbrain có danh sách Task để đồng bộ." FontSize="11"
                         Foreground="#9CB3D5" TextWrapping="Wrap" Margin="0,5,0,8"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TaskSearchBox" Grid.Column="0" Height="30" ToolTip="Tìm mã Task ID" TextChanged="TaskSearch_Changed"/>
                <ComboBox x:Name="TaskFilterBox" Style="{StaticResource TbrainTaskFilterComboStyle}" Grid.Column="1" Width="115" Margin="7,0,0,0"
                          SelectionChanged="TaskFilter_Changed" SelectedIndex="0">
                  <ComboBoxItem Style="{StaticResource TbrainTaskFilterOptionStyle}" Content="Tất cả" Tag="all"/>
                  <ComboBoxItem Style="{StaticResource TbrainTaskFilterOptionStyle}" Content="Chưa quay" Tag="pending"/>
                  <ComboBoxItem Style="{StaticResource TbrainTaskFilterOptionStyle}" Content="Đã quay" Tag="done"/>
                </ComboBox>
              </Grid>
              <ListBox x:Name="TaskListBox" Height="168" Margin="0,7,0,7"
                       Background="#0A172C" Foreground="#F2F7FF" BorderBrush="#2E527D"
                       SelectionChanged="TaskList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto"
                       ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource TbrainTaskRowStyle}">
                <ListBox.Resources>
                  <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource TbrainTaskScrollBarStyle}"/>
                </ListBox.Resources>
                <ListBox.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="3,4">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="27"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <CheckBox Grid.Column="0" VerticalAlignment="Center" Tag="{Binding}"
                                IsChecked="{Binding IsRecorded, Mode=OneWay}"
                                Click="TaskRecorded_Click" ToolTip="Đã quay xong trên máy này"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding DisplayId}" Foreground="#EFF5FF" FontWeight="SemiBold" FontSize="12"/>
                        <TextBlock Text="{Binding StatusText}" Foreground="#9EB5D9" FontSize="10" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
              <TextBlock Text="Chọn tự do hoặc nhập Task ID:" Foreground="#B9CCEA" FontSize="11" Margin="0,0,0,5"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="TaskManualBox" Grid.Column="0" Height="30"
                         ToolTip="Ví dụ AMRF-124-S15" KeyDown="TaskManual_KeyDown"/>
                <Button x:Name="TaskUseButton" Grid.Column="1" Content="Chọn Task" Click="TaskUse_Click"
                        Margin="7,0,0,0" Padding="10,4"/>
              </Grid>
              <TextBlock x:Name="TaskSelectedText" Foreground="#8FBEFF" FontSize="11" FontWeight="SemiBold"
                         Text="Chưa chọn Task" TextWrapping="Wrap" Margin="0,8,0,0"/>
              <TextBlock x:Name="TaskLocalStatus" Foreground="#AFC0DF" FontSize="11"
                         Text="Dấu tích là trạng thái quay cục bộ; Submitted không đồng nghĩa đã quay." TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
          </Border>
          <!-- Room: only the original 0.3.3 WPF controls, relocated unchanged. -->
          <Border Background="#14243D" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="ROOM ONLINE" Foreground="#F0F6FF" FontSize="13" FontWeight="Bold" Margin="0,0,0,9"/>
              <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Label x:Name="PlayerLabel" Grid.Row="0" />
        <StackPanel x:Name="PlayerPanel" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBox x:Name="PlayerBox" AutomationProperties.AutomationId="PlayerBox" Width="150" VerticalContentAlignment="Center" />
            <Label x:Name="NameLabel" Margin="12,0,8,0" />
            <TextBox x:Name="NameBox" AutomationProperties.AutomationId="NameBox" Width="150" VerticalContentAlignment="Center" />
        </StackPanel>

<Label x:Name="RoomLabel" Grid.Row="1" />
        <StackPanel x:Name="RoomPanel" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,6">
            <!-- The current room's invite code, selectable so the host can copy it; the code to join is asked in a dialog. -->
            <TextBox x:Name="RoomBox" AutomationProperties.AutomationId="RoomBox" Width="110" IsReadOnly="True"
                     Visibility="Collapsed" FontFamily="Consolas" FontSize="14" FontWeight="SemiBold"
                     VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
            <!-- The host names each round (the folder every player's capture and the delivered session get). -->
            <TextBlock x:Name="TaskLabel" Visibility="Collapsed" VerticalAlignment="Center" Margin="12,0,4,0" />
            <TextBox x:Name="TaskBox" AutomationProperties.AutomationId="TaskBox" Width="150" Visibility="Collapsed"
                     VerticalContentAlignment="Center" Margin="0,0,12,0" />
            <Button x:Name="JoinButton" AutomationProperties.AutomationId="JoinButton" Click="Join_Click" />
            <Button x:Name="CreateButton" AutomationProperties.AutomationId="CreateButton" Click="Create_Click" />
            <!-- Shown while the Windows clock is off NTP: runs odx clock-sync as administrator. -->
            <Button x:Name="SyncClockButton" AutomationProperties.AutomationId="SyncClockButton" Visibility="Collapsed"
                    Click="SyncClock_Click" />
        </StackPanel>
                </Grid>
              </ScrollViewer>
            </StackPanel>
          </Border>
          <!-- Capture controls: original state/StartStop button are retained. -->
          <Border Background="#14243D" CornerRadius="10" BorderBrush="#2A4D7B" BorderThickness="1" Padding="12" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="GHI HÌNH" Foreground="#F0F6FF" FontSize="13" FontWeight="Bold"/>
              <TextBlock x:Name="TaskElapsedText" Text="00:00:00" Foreground="#F7FAFF" FontFamily="Consolas"
                         FontSize="30" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
<Button x:Name="StartStopButton" AutomationProperties.AutomationId="StartStopButton" Grid.Row="1"
                Grid.ColumnSpan="3" Margin="0,8,0,8" Background="#2863F0" Foreground="#FFFFFF" BorderBrush="#376FFF" FontWeight="Bold" Padding="0,8" FontSize="14" Click="StartStop_Click" />

<TextBlock x:Name="StatusText" AutomationProperties.AutomationId="StatusText" Grid.Row="2"
                   Grid.ColumnSpan="3" Foreground="#D4E2FA" FontSize="12" TextWrapping="Wrap" />
              </Grid>
              <TextBlock x:Name="TaskRecordingHint" Foreground="#9CB3D5" Text="Chưa có phiên quay." FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <!-- Settings remain accessible but need not consume workspace height. -->
          <Expander Header="CÀI ĐẶT GHI HÌNH  ·  Nguồn / FPS / Âm thanh / F10" IsExpanded="False"
                    Foreground="#F0F6FF" Background="#14243D" BorderBrush="#2A4D7B" BorderThickness="1" Padding="9,10">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <Grid Margin="4,8,4,4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
<Label x:Name="LanguageLabel" Grid.Row="0" />
        <ComboBox x:Name="LanguageBox" AutomationProperties.AutomationId="LanguageBox" Grid.Row="0" Grid.Column="1"
                  Margin="0,0,0,6" Width="140" HorizontalAlignment="Left" DisplayMemberPath="Name"
                  SelectionChanged="Language_Changed" />

<Label x:Name="SourceLabel" Grid.Row="1" />
        <ComboBox x:Name="SourceBox" AutomationProperties.AutomationId="SourceBox" Grid.Row="1" Grid.Column="1"
                  Margin="0,0,0,6" DisplayMemberPath="Label" />
        <Button x:Name="RefreshButton" Grid.Row="1" Grid.Column="2" Click="Refresh_Click" />

<Label x:Name="GameLabel" Grid.Row="2" />
        <ComboBox x:Name="GameBox" AutomationProperties.AutomationId="GameBox" Grid.Row="2" Grid.Column="1"
                  SelectionChanged="Game_Changed"
                  Margin="0,0,0,6" DisplayMemberPath="Label" />

<Label x:Name="FpsLabel" Grid.Row="3" />
        <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
            <ComboBox x:Name="FpsBox" Width="80" />
            <CheckBox x:Name="AudioBox" AutomationProperties.AutomationId="AudioBox" Margin="12,0,0,0"
                      VerticalAlignment="Center" />
        </StackPanel>

<Label x:Name="ObsLabel" Grid.Row="4" />
        <CheckBox x:Name="ObsBox" AutomationProperties.AutomationId="ObsBox" Grid.Row="4" Grid.Column="1"
                  Margin="0,0,0,6" VerticalAlignment="Center" Checked="Obs_Changed" Unchecked="Obs_Changed" />

        <!-- OBS connection row: shown only while "Record with OBS" is ticked. -->

<Label x:Name="ObsConnectionLabel" Grid.Row="5" />
        <StackPanel x:Name="ObsConnectionPanel" Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock x:Name="ObsAddressLabel" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBox x:Name="ObsAddressBox" AutomationProperties.AutomationId="ObsAddressBox" Width="120"
                     VerticalContentAlignment="Center" />
            <TextBlock x:Name="ObsPasswordLabel" VerticalAlignment="Center" Margin="12,0,4,0" />
            <PasswordBox x:Name="ObsPasswordBox" AutomationProperties.AutomationId="ObsPasswordBox" Width="100"
                         VerticalContentAlignment="Center" />
        </StackPanel>
        <Button x:Name="ObsTestButton" AutomationProperties.AutomationId="ObsTestButton" Grid.Row="5" Grid.Column="2"
                Click="ObsTest_Click" />

        <!-- Room rows: shown only when odx-capture.json names an orchestrator. -->

<Label x:Name="HotkeyLabel" Grid.Row="6" />
        <TextBox x:Name="HotkeyBox" AutomationProperties.AutomationId="HotkeyBox" Grid.Row="6" Grid.Column="1"
                 Margin="0,0,0,6" IsReadOnly="True" IsReadOnlyCaretVisible="False" VerticalContentAlignment="Center"
                 GotKeyboardFocus="Hotkey_GotFocus" LostKeyboardFocus="Hotkey_LostFocus"
                 PreviewKeyDown="Hotkey_PreviewKeyDown" />
              </Grid>
            </ScrollViewer>
          </Expander>
        </StackPanel>
      </ScrollViewer>
      <Border Grid.Row="2" Background="#10213B" Padding="12,9">
        <TextBlock Foreground="#A8BDDE" FontSize="11" Text="ODX 0.3.3 recording &amp; Room engine · giữ nguyên"/>
      </Border>
    </Grid>
    <GridSplitter Grid.Column="1" Width="6" Background="#35577F" ShowsPreview="True"
                  HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
    <Grid Grid.Column="2" Background="#080E1B">
      <Grid.RowDefinitions>
        <RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" Background="#10213B" LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Margin="16,0,8,0">
          <TextBlock Text="Tbrain Work" Foreground="#F4F7FF" FontSize="17" FontWeight="Bold"/>
          <TextBlock Text="Expert workspace · My projects" Foreground="#8FA6CD" FontSize="11"/>
        </StackPanel>
        <Button x:Name="TbrainLoginButton" Style="{StaticResource TbrainToolbarButtonStyle}" DockPanel.Dock="Right" Content="Đăng nhập lại" Margin="4,12,14,12" Padding="12,3" Click="TbrainLogin_Click"/>
        <Button x:Name="TbrainRefreshButton" Style="{StaticResource TbrainToolbarButtonStyle}" DockPanel.Dock="Right" Content="Tải lại" Margin="4,12,4,12" Padding="12,3" Click="TbrainRefresh_Click"/>
        <Button x:Name="TbrainBackButton" Style="{StaticResource TbrainToolbarButtonStyle}" DockPanel.Dock="Right" Content="←" Margin="4,12,4,12" Padding="12,3" Click="TbrainBack_Click"/>
      </DockPanel>
      <wv2:WebView2 x:Name="TbrainBrowser" Grid.Row="1" Loaded="TbrainBrowser_Loaded"/>
      <Border Grid.Row="2" Background="#10213B" Padding="12,8">
        <TextBlock x:Name="TbrainNotice" Foreground="#B8C9E7" FontSize="11" TextWrapping="Wrap"
                   Text="Tbrain Work · Đồng bộ Task chỉ đọc từ trang đang mở; không thay đổi website."/>
      </Border>
    </Grid>
  </Grid>
</Window>
