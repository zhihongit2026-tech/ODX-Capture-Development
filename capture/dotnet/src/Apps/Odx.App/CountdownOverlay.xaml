<Window x:Class="Odx.App.CountdownOverlay"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Odx Capture countdown" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False" ResizeMode="NoResize"
        SizeToContent="WidthAndHeight" WindowStartupLocation="CenterScreen" IsHitTestVisible="False">
    <Border Background="#B0000000" CornerRadius="24" MinWidth="320" MinHeight="190" Padding="32,18">
        <StackPanel VerticalAlignment="Center">
            <TextBlock x:Name="Number" Foreground="White" FontSize="110" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
            <TextBlock x:Name="ReminderText" Foreground="#FFE08A" FontSize="22" FontWeight="Bold"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0"
                       Visibility="Collapsed" />
        </StackPanel>
    </Border>
</Window>
