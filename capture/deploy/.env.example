# Copied to .env by up.sh (which also generates the access key). The domain's DNS A record must point at this server.
ODX_DOMAIN=capture.example.com
ODX_ACCESS_KEY=change-me
# A file of capture/profiles/: the default game. Every profile there is available; a room plays the game its host chose in odx-app.
ODX_GAME_PROFILE=cs2.json
